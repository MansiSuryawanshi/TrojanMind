# Copy to .env.local and fill in real values. Never commit .env / .env.local.
# Anything prefixed VITE_ is bundled into the browser JavaScript and is PUBLIC.

# Claude API
# WARNING: a VITE_ key ships to every visitor's browser. Move Claude calls to a
# server-side function and rename this to a non-VITE_ secret (e.g. ANTHROPIC_API_KEY).
VITE_CLAUDE_API_KEY=sk-ant-api03-your_key_here

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These identify the project and are safe to expose; security comes from
# Firebase Auth + Firestore Security Rules, not from hiding these values.
# Used by Firestore and by Firebase Authentication (email/password login).
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-side only (never VITE_-prefixed, never in this repo):
# - Firebase Admin SDK service-account JSON, if you later verify ID tokens on a backend.
