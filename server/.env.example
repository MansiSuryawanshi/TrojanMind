# TrojanMind local connector: SERVER-ONLY settings.
# Copy to server/.env.local (gitignored). Never use a VITE_ prefix here:
# VITE_ variables are bundled into browser JavaScript.

# Same Firebase project as the frontend (not a secret).
FIREBASE_PROJECT_ID=your_project_id

# REQUIRED. The Firebase Authentication UID of the one person whose Brightspace
# session is signed in on this computer. Find it in Firebase console >
# Authentication > Users > "User UID" column. Every other user is refused.
LOCAL_BRIGHTSPACE_OWNER_UID=

# REQUIRED. The Brightspace "uniqueName" of the account signed in on this
# computer. Course data is returned only when the connector's session matches.
# Find it with MCP Inspector: call get_server_info and copy signedInAs.uniqueName.
LOCAL_BRIGHTSPACE_EXPECTED_UNIQUE_NAME=

# OPTIONAL. Path to a Firebase Admin service-account JSON kept OUTSIDE this repo
# (e.g. C:\Users\you\secrets\trojanmind-admin.json). Enables revoked-token checks.
# Token signature verification works without it.
# GOOGLE_APPLICATION_CREDENTIALS=

# OPTIONAL. Brightspace origin used to resolve relative links in course content.
# Defaults to the school URL the local connector is configured with.
# BRIGHTSPACE_BASE_URL=https://brightspace.usc.edu

# OPTIONAL overrides.
# LOCAL_CONNECTOR_PORT=8787
# LOCAL_CONNECTOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# BRIGHTSPACE_MCP_COMMAND=cmd
# BRIGHTSPACE_MCP_ARGS=["/c","npx","-y","brightspace-mcp-server@latest"]
